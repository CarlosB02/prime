rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    
    function isAdmin() {
      return isSignedIn() && request.auth.token.email in [
        'Carlosbernardo.2002@gmail.com', 
        'carlosbernardo.2002@gmail.com',
        'renatorodrigues_92@hotmail.com'
      ];
    }
    
    function isValidClient(data) {
      return data.keys().hasAll(['name', 'ownerId', 'createdAt'])
        && data.name is string && data.name.size() <= 100
        && data.createdAt is timestamp;
    }
    
    match /clients/{clientId} {
      allow read: if isAdmin() || (isSignedIn() && existing().ownerId == request.auth.uid);
      allow create: if isAdmin() || (isSignedIn() && isValidId(clientId) && isValidClient(incoming()) && incoming().createdAt == request.time);
      allow update: if isAdmin() || (isSignedIn() && isValidId(clientId) && incoming().ownerId == existing().ownerId && isValidClient(incoming()));
      allow delete: if isAdmin() || (isSignedIn() && existing().ownerId == request.auth.uid);
    }
    
    match /exercises/{exerciseId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || (isSignedIn() && isValidId(exerciseId) && incoming().ownerId == request.auth.uid && incoming().createdAt == request.time);
      allow update: if isAdmin() || (isSignedIn() && isValidId(exerciseId) && incoming().ownerId == existing().ownerId);
      allow delete: if isAdmin() || (isSignedIn() && existing().ownerId == request.auth.uid);
    }
  }
}
