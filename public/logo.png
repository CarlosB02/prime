<svg xmlns="http://www.w3.org/2000/svg" viewBox="-15 -10 890 1025" width="800" height="920">
  <defs>
    <!-- Background Drop Glow -->
    <filter id="primeGlow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="8" stdDeviation="14" flood-color="#00d4ff" flood-opacity="0.4" />
    </filter>

    <!-- Metallic Gradient for Loop -->
    <linearGradient id="pLoopMetal" x1="15%" y1="5%" x2="90%" y2="90%">
      <stop offset="0%" stopColor="#00e5ff" />
      <stop offset="15%" stopColor="#00a6ff" />
      <stop offset="45%" stopColor="#006ad1" />
      <stop offset="75%" stopColor="#004499" />
      <stop offset="100%" stopColor="#002255" />
    </linearGradient>

    <!-- Metallic Gradient for Stem -->
    <linearGradient id="pStemMetal" x1="100%" y1="10%" x2="10%" y2="95%">
      <stop offset="0%" stopColor="#00bfff" />
      <stop offset="25%" stopColor="#0080ea" />
      <stop offset="55%" stopColor="#004f9e" />
      <stop offset="85%" stopColor="#002b66" />
      <stop offset="100%" stopColor="#00143a" />
    </linearGradient>

    <!-- Glowing Cyan Edge Stroke -->
    <linearGradient id="pCyanEdge" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stopColor="#67e8f9" />
      <stop offset="30%" stopColor="#38bdf8" />
      <stop offset="70%" stopColor="#0284c7" />
      <stop offset="100%" stopColor="#00f0ff" />
    </linearGradient>

    <!-- 3D Bevel Rim Highlight Gradient -->
    <linearGradient id="pTopSpecular" x1="20%" y1="0%" x2="80%" y2="40%">
      <stop offset="0%" stopColor="#ffffff" stopOpacity="0.85" />
      <stop offset="30%" stopColor="#7dd3fc" stopOpacity="0.6" />
      <stop offset="70%" stopColor="#0ea5e9" stopOpacity="0" />
    </linearGradient>

    <linearGradient id="pInnerBevel" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stopColor="#38bdf8" />
      <stop offset="100%" stopColor="#0369a1" />
    </linearGradient>
  </defs>

  <g id="prime-logo-mark" filter="url(#primeGlow)">
    <!-- 1. MAIN OUTER LOOP (The P Arch) -->
    <!-- Base dark bevel border for 3D depth -->
    <path
      d="M 10,10 L 570,10 C 750,10 860,130 860,290 C 860,450 750,580 570,580 L 280,580 L 395,465 L 550,465 C 655,465 720,390 720,290 C 720,190 655,125 550,125 L 125,125 Z"
      fill="url(#pLoopMetal)"
      stroke="#001a3d"
      strokeWidth="18"
      strokeLinejoin="miter"
      strokeMiterlimit="4"
    />

    <!-- Cyan Beveled Outer Rim -->
    <path
      d="M 10,10 L 570,10 C 750,10 860,130 860,290 C 860,450 750,580 570,580 L 280,580 L 395,465 L 550,465 C 655,465 720,390 720,290 C 720,190 655,125 550,125 L 125,125 Z"
      fill="url(#pLoopMetal)"
      stroke="url(#pCyanEdge)"
      strokeWidth="10"
      strokeLinejoin="miter"
      strokeMiterlimit="4"
    />

    <!-- Inner Metallic Inset Facet -->
    <path
      d="M 26,22 L 566,22 C 735,22 842,135 842,290 C 842,442 735,568 566,568 L 295,568 L 395,468 L 550,468 C 650,468 705,395 705,290 C 705,185 650,137 550,137 L 140,137 Z"
      fill="none"
      stroke="url(#pInnerBevel)"
      strokeWidth="4"
      strokeOpacity="0.9"
    />

    <!-- Specular Highlight on Top Arch -->
    <path
      d="M 35,16 L 565,16 C 730,16 830,115 840,240"
      fill="none"
      stroke="url(#pTopSpecular)"
      strokeWidth="7"
      strokeLinecap="round"
    />

    <!-- 2. STEM & CHEVRON (The P Leg) -->
    <!-- Base dark bevel border for 3D depth -->
    <path
      d="M 265,275 L 435,275 L 195,515 L 195,990 L 65,860 L 65,475 Z"
      fill="url(#pStemMetal)"
      stroke="#001a3d"
      strokeWidth="18"
      strokeLinejoin="miter"
      strokeMiterlimit="4"
    />

    <!-- Cyan Beveled Outer Rim -->
    <path
      d="M 265,275 L 435,275 L 195,515 L 195,990 L 65,860 L 65,475 Z"
      fill="url(#pStemMetal)"
      stroke="url(#pCyanEdge)"
      strokeWidth="10"
      strokeLinejoin="miter"
      strokeMiterlimit="4"
    />

    <!-- Inner Inset Facet for Stem -->
    <path
      d="M 280,287 L 416,287 L 183,520 L 183,968 L 77,862 L 77,482 Z"
      fill="none"
      stroke="url(#pInnerBevel)"
      strokeWidth="4"
      strokeOpacity="0.9"
    />

    <!-- Specular Highlight along Left Outer Edge & Corner -->
    <path
      d="M 275,280 L 70,480 L 70,850"
      fill="none"
      stroke="url(#pTopSpecular)"
      strokeWidth="6"
      strokeLinecap="round"
      strokeLinejoin="round"
    />
  </g>
</svg>